{
  "name": "hiresense",
  "version": "1.0.0",
  "description": "Upload a resume PDF, paste a job description, get a match score and concrete fixes.",
  "type": "module",
  "main": "server/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "test": "node --test server/keywords.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "1.1.1"
  },
  "license": "MIT"
}
